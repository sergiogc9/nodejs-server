{
	"name": "@sergiogc9/nodejs-utils",
	"version": "1.4.0",
	"description": "NodeJS TypeScript utils",
	"author": "Sergio Gómez Cosgaya (sergiogcosgaya@gmail.com)",
	"repository": "git://github.com/sergiogc9/nodejs-server.git",
	"keywords": [
		"nodejs",
		"server",
		"utils",
		"lib",
		"log",
		"cache",
		"mongodb",
		"pushover"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./Api": {
			"types": "./dist/Api/index.d.ts",
			"import": "./dist/Api/index.js"
		},
		"./Auth": {
			"types": "./dist/Auth/index.d.ts",
			"import": "./dist/Auth/index.js"
		},
		"./Cache": {
			"types": "./dist/Cache/index.d.ts",
			"import": "./dist/Cache/index.js"
		},
		"./Log": {
			"types": "./dist/Log/index.d.ts",
			"import": "./dist/Log/index.js"
		},
		"./Pushover": {
			"types": "./dist/Pushover/index.d.ts",
			"import": "./dist/Pushover/index.js"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit"
	},
	"engines": {
		"node": ">=26"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"fastify": "^5.11.2",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"lru-cache": "^11.5.2",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3"
	},
	"peerDependencies": {
		"fastify": "^5.11.2"
	}
}
