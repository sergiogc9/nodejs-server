{
	"name": "@sergiogc9/nodejs-server",
	"version": "1.4.1",
	"description": "NodeJS Typescript Server",
	"author": "Sergio Gómez Cosgaya (sergiogcosgaya@gmail.com)",
	"repository": "git://github.com/sergiogc9/nodejs-server.git",
	"keywords": [
		"nodejs",
		"server",
		"fastify"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit"
	},
	"engines": {
		"node": ">=26"
	},
	"dependencies": {
		"@fastify/compress": "^9.1.0",
		"@fastify/cors": "^11.3.0",
		"@fastify/helmet": "^13.1.0",
		"@fastify/rate-limit": "^11.2.0",
		"@fastify/static": "^10.1.2",
		"@fastify/swagger": "^9.8.1",
		"@fastify/swagger-ui": "^6.1.1",
		"@fastify/view": "^12.0.0",
		"@sergiogc9/nodejs-utils": "workspace:*",
		"close-with-grace": "^2.5.0",
		"ejs": "^6.0.1",
		"fastify": "^5.11.2",
		"fastify-type-provider-zod": "^7.0.0",
		"mongoose": "^9.9.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/ejs": "^3.1.5",
		"@types/node": "^26.1.2",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	}
}
