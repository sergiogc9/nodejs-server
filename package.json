{
	"name": "nodejs-server-monorepo",
	"version": "0.0.0",
	"description": "NodeJS Server & Libs",
	"private": true,
	"type": "module",
	"repository": "git://github.com/sergiogc9/nodejs-server.git",
	"author": "Sergio Gómez Cosgaya (sergiogcosgaya@gmail.com)",
	"packageManager": "pnpm@11.20.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"build": "pnpm -r build",
		"start": "tsx examples/index.ts",
		"dev": "tsx watch examples/index.ts",
		"typecheck": "pnpm -r typecheck && tsc -p examples/tsconfig.json",
		"lint": "eslint .",
		"prettier": "prettier --write .",
		"prettier:check": "prettier --check .",
		"test": "vitest run --passWithNoTests",
		"prepare": "husky",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "pnpm build && changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"@fastify/view": "^12.0.0",
		"@sergiogc9/eslint-config": "^2.0.0",
		"@sergiogc9/nodejs-server": "workspace:*",
		"@sergiogc9/nodejs-utils": "workspace:*",
		"@types/node": "^26.1.2",
		"eslint": "^9.39.5",
		"fastify": "^5.11.2",
		"fastify-type-provider-zod": "^7.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"tsx": "^4.23.5",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10",
		"zod": "^4.4.3"
	},
	"lint-staged": {
		"*.{js,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,yaml,yml}": "prettier --write"
	}
}
